{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "text": {
      "primary": { "$value": { "colorSpace": "srgb", "components": [0.071, 0.188, 0.31], "hex": "#12304F" } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.31, 0.392, 0.459], "hex": "#4F6475" }, "$description": "也用於輸入框邊框（≥3:1）" }
    },
    "tide": {
      "low": { "$value": { "colorSpace": "srgb", "components": [0.122, 0.435, 0.545], "hex": "#1F6F8B" }, "$description": "充電、預調度線；禁止用於 14px 以下文字" },
      "high": { "$value": { "colorSpace": "srgb", "components": [0.612, 0.184, 0.333], "hex": "#9C2F55" }, "$description": "放電、錯誤" }
    },
    "surface": {
      "page": { "$value": { "colorSpace": "srgb", "components": [0.957, 0.969, 0.976], "hex": "#F4F7F9" } },
      "raised": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } }
    },
    "band": {
      "low": { "$value": { "colorSpace": "srgb", "components": [0.863, 0.91, 0.933], "hex": "#DCE8EE" } },
      "high": { "$value": { "colorSpace": "srgb", "components": [0.953, 0.882, 0.91], "hex": "#F3E1E8" } }
    },
    "rule": { "$value": { "colorSpace": "srgb", "components": [0.788, 0.827, 0.859], "hex": "#C9D3DB" }, "$description": "僅裝飾分隔線與未選中色帶格，不可當輸入框邊框" }
  },
  "font": {
    "$type": "fontFamily",
    "display-zh": { "$value": ["Noto Serif TC", "Source Han Serif TC", "Songti TC", "PMingLiU", "serif"], "$description": "系統襯線，不載入網頁字型；只用於結論與標題" },
    "display-num": { "$value": ["Source Serif 4", "Georgia", "Noto Serif TC", "serif"] },
    "body": { "$value": ["PingFang TC", "Noto Sans TC", "Microsoft JhengHei", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "Menlo", "Consolas", "monospace"] }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "strong": { "$value": 600 }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": { "$value": { "value": 12, "unit": "px" }, "$description": "只用於圖表刻度、來源代號、頁尾" },
    "sm": { "$value": { "value": 14, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 20, "unit": "px" } },
    "xl": { "$value": { "value": 28, "unit": "px" } },
    "hero": { "$value": { "value": 56, "unit": "px" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "section": { "$value": { "value": 24, "unit": "px" } },
    "block": { "$value": { "value": 40, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 4, "unit": "px" } },
    "none": { "$value": { "value": 0, "unit": "px" } }
  },
  "motion": {
    "tide-fill": { "$type": "duration", "$value": { "value": 240, "unit": "ms" } },
    "tide-ease": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] }
  }
}
